{
  "manifest_version": 3,
  "name": "Meshy Downloader",
  "version": "1.2",
  "description": "Download Meshy 3D models (CC0) directly from the viewer",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["https://www.meshy.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://www.meshy.ai/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Meshy Downloader",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
